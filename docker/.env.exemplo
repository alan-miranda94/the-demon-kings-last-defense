OPENROUTER_API_KEY=sk-or-xx


OPENAI_API_KEY=sk-proj-xxx
GOOGLE_API_KEY=xxx
 

LANGSMITH_API_KEY=lsv2_pt_xxx
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=the-demon-kings-last-defense

POSTEGRE_DB=postgresql://postgres:mysecretpassword@localhost:5433/the_demon_kings_last_defense


IMAGE_GENERATION_PROVIDER=google

OPENAI_IMAGE_MODEL=gpt-5.4
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=low

GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image-preview
GOOGLE_IMAGE_SIZE=1K
GOOGLE_IMAGE_ASPECT_RATIO=1:1


# Só use se o modelo exigir autenticação no Hugging Face.
HF_TOKEN=hf_xx

TTS_HOME=voices
HF_HOME=voices
COQUI_TOS_AGREED=1

# Carrega o XTTS para clonagem/customização de voz
PRELOAD_MODEL=xtts

# Opcional: logs mais detalhados
# EXTRA_ARGS=--log-level DEBUG